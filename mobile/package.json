{
  "name": "@illirent/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --port 3103",
    "android": "expo run:android --port 3103",
    "ios": "expo run:ios --port 3103",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "export:check": "expo export --platform android --platform ios --output-dir dist",
    "beta:check": "node scripts/check-beta.mjs",
    "eas-build-post-install": "node scripts/eas-beta-check.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@illirent/api-client": "0.0.0",
    "@illirent/core": "0.0.0",
    "@illirent/design-tokens": "0.0.0",
    "@illirent/search-state": "^0.0.0",
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "2.108.2",
    "@tanstack/react-query": "^5.108.0",
    "expo": "~57.0.33",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.23",
    "expo-constants": "~57.0.24",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.14",
    "expo-router": "~57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.4",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react"
      ]
    }
  }
}
