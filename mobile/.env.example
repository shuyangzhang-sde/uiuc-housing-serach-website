# Public client configuration. Never use a Supabase service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Use FastAPI directly, not the cookie-authenticated Next.js /api proxy.
# Default: deployed listing service; no local backend process is needed.
# For backend development only, start FastAPI and use:
# Android emulator: http://10.0.2.2:3101
# iOS simulator: http://localhost:3101
# Physical phone: http://YOUR_COMPUTER_LAN_IP:3101 (bind backend to 0.0.0.0)
EXPO_PUBLIC_API_URL=https://alluring-joy-production-a6f2.up.railway.app

# Telemetry is disabled in development builds, even if enabled here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_ANALYTICS_ENABLED=false
# Public Sentry ingestion URL, not an authentication token.
EXPO_PUBLIC_SENTRY_DSN=
# Build settings (never prefix private tokens with EXPO_PUBLIC_).
SENTRY_ORG=
SENTRY_PROJECT=
# Set SENTRY_AUTH_TOKEN as an EAS secret, not in committed files.
EXPO_PROJECT_ID=
